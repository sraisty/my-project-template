{
  "name": "my-project-generic-backend-service",
  "description": "a template sample backend project, all configured",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-specifier-resolution=node --watch ./src/index.ts",
    "start": "node --experimental-specifier-resolution=node dist/index.js",
    "lint": "eslint --ext .ts",
    "format": "eslint --fix src/**/*.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "tsc": "tsc"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "node-fetch": "^3.3.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11"
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
}