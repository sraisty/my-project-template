{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext", // for backend projects
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // "outDir": "./dist",
    // "rootDir": "./src",
    "sourceMap": true, // Enable source maps for better debugging
    "types": ["node"], // Ensure Node.js types are included
    "isolatedModules": true, // Ensure compatibility with modern ESM loaders
    "allowSyntheticDefaultImports": true, // Allow default imports from CJS modules

    // Linting
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "useDefineForClassFields": true // Needed for classes in ES2022 & later
  }
}
