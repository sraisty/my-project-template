{
  "name": "my-project-template",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for my project, including frontend and backend microservices",
  "main": "index.js",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend/generic-backend-service",
    "backend/auth-service"
  ],
  "scripts": {
    "dev": "./scripts/npm-run-script.sh dev",
    "start": "./scripts/npm-run-script.sh start",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@eslint/js": "^9.21.0",
    "@typescript-eslint/eslint-plugin": "8.25.0",
    "@typescript-eslint/parser": "8.25.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=23.0.0"
  }
}