{
  "name": "my-project",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for my project, including frontend and backend microservices",
  "main": "index.js",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend/generic-backend-service",
    "backend/auth-service"
  ],
  "scripts": {
